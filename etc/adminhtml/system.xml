<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="citecue" translate="label" sortOrder="400">
            <label>Citecue</label>
        </tab>
        <section id="citecue_delivery" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>AI Delivery</label>
            <tab>citecue</tab>
            <resource>Citecue_Delivery::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Serve Citecue AI-optimized page versions to AI bots and crawlers. All other visitors always get the normal page.</comment>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment><![CDATA[Your organization API key (<code>ck_live_…</code>) from the Citecue dashboard &rarr; Organization &rarr; API keys. Stored encrypted.]]></comment>
                </field>
                <field id="public_key" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Project Public Key</label>
                    <comment><![CDATA[The public key of the Citecue project for this store's domain. Use <b>Test Connection</b> below to list your projects and their keys.]]></comment>
                </field>
                <field id="test_connection" translate="label" type="button" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label/>
                    <frontend_model>Citecue\Delivery\Block\Adminhtml\System\Config\TestConnection</frontend_model>
                </field>
                <field id="serve_llms_txt" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Serve llms.txt</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Serve the project's <code>llms.txt</code> (llmstxt.org convention) at this store's domain root. Also requires "Serve llms.txt" to be enabled for the project in the Citecue dashboard.]]></comment>
                </field>
            </group>
            <group id="advanced" translate="label" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Advanced</label>
                <field id="base_url" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Citecue API Base URL</label>
                    <backend_model>Citecue\Delivery\Model\Config\Backend\BaseUrl</backend_model>
                    <comment>Only change this if Citecue support tells you to. Must be a valid https:// URL.</comment>
                </field>
                <field id="timeout" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Request Timeout (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <comment>Total timeout for a delivery API request. On timeout the crawler gets the normal page (fail-open).</comment>
                </field>
                <field id="connect_timeout" translate="label" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Connect Timeout (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="local_cache_ttl" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Local Cache TTL (seconds)</label>
                    <validate>validate-digits</validate>
                    <comment>0 = revalidate with the Citecue API on every crawler request (exact Agent Traffic analytics; conditional 304 responses are cheap). Higher values serve repeat crawler hits straight from the local cache for that many seconds.</comment>
                </field>
                <field id="excluded_paths" translate="label comment" type="textarea" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Excluded Path Prefixes</label>
                    <comment>One path prefix per line. Requests whose path starts with one of these are never intercepted (matched on full path segments).</comment>
                </field>
                <field id="debug_logging" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Debug Logging</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Log every crawler detection and delivery API call to var/log/debug.log.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
