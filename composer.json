{
    "name": "citecue/module-delivery",
    "description": "Citecue AI delivery middleware for Magento 2 — serves AI-optimized (auto-fixed) page versions to AI bots and crawlers via the Citecue delivery API, and passes every other visitor through untouched.",
    "type": "magento2-module",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "magento2",
        "citecue",
        "ai",
        "llm",
        "crawlers",
        "geo",
        "aeo"
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": ">=103.0.4 <104",
        "magento/module-store": ">=101.0.0 <102",
        "magento/module-backend": ">=102.0.0 <103",
        "magento/module-config": ">=101.0.0 <102",
        "magento/module-page-cache": ">=100.4.0 <101",
        "magento/module-cron": ">=100.4.0 <101"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Citecue\\Delivery\\": ""
        }
    }
}
