?>
<button type="button" id="citecue_test_connection_btn" class="action-default scalable">
    <span><?= $escaper->escapeHtml(__('Test Connection')) ?></span>
</button>
<p class="note">
    <span><?= $escaper->escapeHtml(__('Verifies the API key against the Citecue API and lists your projects with their public keys.')) ?></span>
</p>
<div id="citecue_test_connection_result" style="margin-top:10px;"></div>
<script>
require(['jquery'], function ($) {
    'use strict';

    var esc = function (value) {
        return $('<span></span>').text(String(value == null ? '' : value)).html();
    };

    $('#citecue_test_connection_btn').on('click', function () {
        var $btn = $(this),
            $result = $('#citecue_test_connection_result');

        $btn.prop('disabled', true);
        $result.html('<span><?= $escaper->escapeJs(__('Testing…')) ?></span>');

        $.ajax({
            url: '<?= $escaper->escapeJs($block->getAjaxUrl()) ?>',
            type: 'POST',
            dataType: 'json',
            data: {
                form_key: window.FORM_KEY,
                api_key: $('#citecue_delivery_general_api_key').val() || '',
                public_key: $('#citecue_delivery_general_public_key').val() || '',
                base_url: $('#citecue_delivery_advanced_base_url').val() || '',
                store: '<?= $block->getRequest()->getParam('store') !== null ? (int)$block->getRequest()->getParam('store') : '' ?>',
                website: '<?= $block->getRequest()->getParam('website') !== null ? (int)$block->getRequest()->getParam('website') : '' ?>'
            }
        }).done(function (response) {
            if (!response || !response.success) {
                $result.html(
                    '<div class="message message-error error"><div>'
                    + esc(response && response.message ? response.message : '<?= $escaper->escapeJs(__('Connection failed.')) ?>')
                    + '</div></div>'
                );
                return;
            }
            var html = '<div class="message message-success success"><div>' + esc(response.message) + '</div></div>';
            if (response.projects && response.projects.length) {
                html += '<table class="admin__table-secondary" style="margin-top:8px;">'
                    + '<thead><tr>'
                    + '<th><?= $escaper->escapeJs(__('Domain')) ?></th>'
                    + '<th><?= $escaper->escapeJs(__('Public Key')) ?></th>'
                    + '<th><?= $escaper->escapeJs(__('Delivery')) ?></th>'
                    + '<th><?= $escaper->escapeJs(__('llms.txt')) ?></th>'
                    + '<th></th>'
                    + '</tr></thead><tbody>';
                $.each(response.projects, function (i, project) {
                    html += '<tr>'
                        + '<td>' + esc(project.domain) + '</td>'
                        + '<td><code>' + esc(project.publicKey) + '</code></td>'
                        + '<td>' + (project.enabled
                            ? '<?= $escaper->escapeJs(__('Enabled')) ?>'
                            : '<strong><?= $escaper->escapeJs(__('Disabled in Citecue')) ?></strong>') + '</td>'
                        + '<td>' + (project.serveLlmsTxt
                            ? '<?= $escaper->escapeJs(__('On')) ?>'
                            : '<?= $escaper->escapeJs(__('Off')) ?>') + '</td>'
                        + '<td>' + (project.current
                            ? '<strong><?= $escaper->escapeJs(__('Currently selected')) ?></strong>'
                            : '<button type="button" class="action-secondary citecue-use-key" data-key="' + esc(project.publicKey) + '"><span><?= $escaper->escapeJs(__('Use this key')) ?></span></button>')
                        + '</td>'
                        + '</tr>';
                });
                html += '</tbody></table>';
            }
            $result.html(html);
            $result.find('.citecue-use-key').on('click', function () {
                $('#citecue_delivery_general_public_key').val($(this).data('key')).trigger('change');
                $(this).replaceWith('<strong><?= $escaper->escapeJs(__('Selected — save the configuration')) ?></strong>');
            });
        }).fail(function () {
            $result.html(
                '<div class="message message-error error"><div><?= $escaper->escapeJs(__('Request failed — check the network tab / admin session.')) ?></div></div>'
            );
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });
});
</script>
